{
  // Deploy with: npx wrangler deploy  (or setup.sh; see the main README)
  "name": "bring-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // setup.sh adds the OAUTH_KV namespace (OAuth clients and grants) here on first run.
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`): BRING_EMAIL, BRING_PASSWORD,
  // and optionally BRING_LIST (list used when none is named).
}
